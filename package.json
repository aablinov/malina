{
  "name": "malina",
  "version": "1.0.0",
  "description": "Malina — a cosy co-op dungeon crawler with tower defence in a voxel style",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc && tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "test": "playwright test",
    "blocks": "node scripts/gen-blocks.mjs",
    "decor": "node scripts/gen-decor.mjs",
    "map:playground": "node scripts/export-map.ts playground",
    "map:rooms": "node scripts/export-map.ts rooms",
    "map:island": "node scripts/export-map.ts island",
    "map:td": "node scripts/export-map.ts td",
    "map:td2": "node scripts/export-map.ts td2",
    "map:td3": "node scripts/export-map.ts td3",
    "map:td4": "node scripts/export-map.ts td4",
    "map:td5": "node scripts/export-map.ts td5",
    "prefabs": "node scripts/gen-prefabs.ts",
    "server": "node server/main.ts",
    "server:test": "node --test 'server/test/*.test.ts'",
    "test:net": "node --test 'server/test/*.test.ts'"
  },
  "dependencies": {
    "three": "^0.169.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.19.2",
    "@types/three": "^0.169.0",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.0.3"
  },
  "private": true,
  "type": "module"
}
